# Copy to .env in this folder (or server/.env). Never commit .env.

# Primary LLM (Phase 3) — required for Groq replies
GROQ_API_KEY=

# Optional fallback when Groq is rate-limited or unreachable
OPENROUTER_API_KEY=

# Optional: OpenAI moderation when safety.moderation is "openai" in config.json
OPENAI_API_KEY=

# Bridge / client auth (Phase 0)
ASTRA_AUTH_TOKEN=
ASTRA_CLIENT_TOKEN=
