#pragma once

// Copy this file to secrets.h (gitignored) and fill in your network.
// The laptop running `python bridge.py` must be on the same Wi-Fi.

#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"
#define BRIDGE_HOST "192.168.1.50"
#define BRIDGE_PORT 8765
// Optional: match bridge ASTRA_AUTH_TOKEN when security.require_auth is on.
#define BRIDGE_TOKEN ""
// Set to 1 for wss:// (TLS). Host must match your certificate or tunnel.
#define BRIDGE_USE_TLS 0
